# Copy to .env.local for local development. Never commit the copied file.
# This application never reads CILT usernames or passwords from environment variables.

# Leave empty when serving from the domain root.
BASE_PATH=""
NEXT_PUBLIC_BASE_PATH=""

# Local Redis for short-lived CILT sessions. Use a unique non-production value.
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="replace-with-a-local-redis-password"

# Separate Redis for public tickets. It intentionally persists ticket text.
TICKET_REDIS_HOST="127.0.0.1"
TICKET_REDIS_PORT="6380"
TICKET_REDIS_PASSWORD="replace-with-a-different-local-redis-password"

# At least 24 random characters. Used only for one-way rate-limit and duplicate hashes.
TICKET_RATE_SALT="replace-with-a-local-random-secret-at-least-24-characters"
