apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: wu-s
type: Opaque
stringData:
  # Set from the deployment environment; never commit a real value.
  REDIS_PASSWORD: "${REDIS_PASSWORD}"
  # Separate persistent store for public tickets. Never reuse the CILT-session store.
  TICKET_REDIS_PASSWORD: "${TICKET_REDIS_PASSWORD}"
  # One-way salt for anonymous rate-limit and duplicate fingerprints; never log it.
  TICKET_RATE_SALT: "${TICKET_RATE_SALT}"
