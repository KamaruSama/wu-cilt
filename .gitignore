# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# dev testing scripts and debug files
test-login.js
debug-html.js
staff-*.html
/scripts/
/live-test-*.md
/TIMELINE.md
*.bak-*
*.backup
*.log

# Local assistant/editor state and deployment-only files
.claude/
.vscode/
.idea/
docker-compose*.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# K3s secrets (generated files with real passwords - NEVER commit!)
k3s-manifests/01-secrets.yaml
k3s-manifests/*-secret.yaml
*.secret.yaml
